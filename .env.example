# Student Management Dashboard - Safe Configuration Template
# Placeholders only. Real values must be configured in Vercel or local .env

# Web App endpoint URL of the deployed Google Apps Script backend
VITE_APPS_SCRIPT_API_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# Environment name (development | preview | production)
VITE_APP_ENV=development

# Google OAuth Client ID for identity provider sign-in
VITE_GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
