# Personal Dashboard - Safe Configuration Template
# Zero Google Cloud Console / Zero GCP Dependency Architecture

# Web App endpoint URL of the deployed Google Apps Script backend (ends with /exec)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# Environment mode (development | preview | production)
VITE_APP_ENV=development
